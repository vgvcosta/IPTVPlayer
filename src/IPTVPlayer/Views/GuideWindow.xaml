<Window x:Class="IPTVPlayer.Views.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IPTVPlayer.ViewModels"
        xmlns:views="clr-namespace:IPTVPlayer.Views"
        xmlns:controls="clr-namespace:IPTVPlayer.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:GuideViewModel}"
        Title="Guia TV" Width="1280" Height="800" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding WatchCommand}" />
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding NextCommand}" />
        <KeyBinding Key="Home" Command="{Binding GoToNowCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Largura da coluna dos canais e da barra de deslocamento (para alinhar cabeçalho, linhas e "agora") -->
        <GridLength x:Key="ChannelColumnWidth">230</GridLength>

        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockContainer" TargetType="ContentPresenter">
            <Setter Property="controls:TimelinePanel.Start" Value="{Binding Start}" />
            <Setter Property="controls:TimelinePanel.Length" Value="{Binding Length}" />
        </Style>

        <DataTemplate x:Key="BlockTemplate" DataType="{x:Type vm:ProgrammeBlockViewModel}">
            <Border x:Name="Bd" Margin="1,3" CornerRadius="5" Padding="8,4" Cursor="Hand" ClipToBounds="True"
                    Background="{StaticResource Surface2Brush}" ToolTip="{Binding}"
                    MouseLeftButtonDown="Block_MouseLeftButtonDown">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="12" Margin="0,1,5,0"
                                   Foreground="{StaticResource AccentHoverBrush}" ToolTip="Disponível no arquivo (catch-up)"
                                   Visibility="{Binding CanCatchup, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNow}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <DockPanel Margin="20,14,20,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Só canais com EPG" IsChecked="{Binding OnlyWithEpg}" Foreground="{StaticResource TextBrush}"
                          VerticalAlignment="Center" Margin="0,0,20,0" FontSize="14" />
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Hora anterior (Ctrl+←)"
                        AutomationProperties.Name="Hora anterior" Command="{Binding PreviousCommand}" />
                <Button Content="Agora" Margin="6,0" Padding="14,6" ToolTip="Voltar a agora (Home)" Command="{Binding GoToNowCommand}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Hora seguinte (Ctrl+→)"
                        AutomationProperties.Name="Hora seguinte" Command="{Binding NextCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Guia TV" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GroupName}" Style="{StaticResource SecondaryText}" FontSize="15" Margin="14,4,0,0" />
                <TextBlock Text="{Binding DateLabel}" FontSize="17" Margin="24,2,0,0" Foreground="{StaticResource AccentHoverBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Horas -->
        <Grid Grid.Row="1" Height="30" Background="{StaticResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ChannelColumnWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Markers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:TimelinePanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="controls:TimelinePanel.Start" Value="{Binding Start}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TimeMarker}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="6,0,0,0">
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Linhas (virtualizadas) -->
        <ListBox x:Name="RowList" Grid.Row="2" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                 ItemsSource="{Binding Rows}" AutomationProperties.Name="Grelha"
                 ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GuideRowViewModel}">
                    <Grid Height="58">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ChannelColumnWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" Padding="10,0" Cursor="Hand"
                                ToolTip="Ver este canal" MouseLeftButtonUp="Channel_MouseLeftButtonUp">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="48" Height="36" CornerRadius="5" Background="{StaticResource Surface2Brush}"
                                        Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="{Binding Channel.Initials}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image views:ImageLoader.SourceUrl="{Binding Channel.LogoUrl}" Margin="3" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Channel.Name}" FontSize="15" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Sem informação de programação" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" Margin="12,0"
                                   Visibility="{Binding HasProgrammes, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource BlockTemplate}"
                                      ItemContainerStyle="{StaticResource BlockContainer}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:TimelinePanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="Nenhum canal deste grupo tem programação. Desmarca &quot;Só canais com EPG&quot; ou escolhe outro grupo."
                   Style="{StaticResource SecondaryText}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="40" TextAlignment="Center"
                   Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisibility}}" />

        <!-- Linha "agora" -->
        <Grid Grid.Row="1" Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ChannelColumnWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <controls:TimelinePanel Grid.Column="1" ClipToBounds="True">
                <Border controls:TimelinePanel.Start="{Binding NowFraction}" Width="2" Background="{StaticResource ErrorBrush}"
                        HorizontalAlignment="Left" />
            </controls:TimelinePanel>
        </Grid>

        <!-- Detalhes do programa escolhido -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,14" MinHeight="96">
            <Grid>
                <TextBlock Text="Clica num programa para ver os detalhes. Clica no canal (à esquerda) ou em &quot;Ver canal&quot; para o abrir."
                           Style="{StaticResource SecondaryText}" FontSize="15" VerticalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Ver canal em direto" VerticalAlignment="Center"
                            Margin="10,0,0,0" Command="{Binding WatchSelectedCommand}" />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Padding="14,8"
                            Command="{Binding RecordCommand}"
                            Visibility="{Binding CanRecord, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Gravar" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0" Padding="14,8"
                            Command="{Binding WatchCatchupCommand}"
                            Visibility="{Binding CanWatchCatchup, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CatchupButtonText}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Selected.Title, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,2,0,6">
                            <Run Text="{Binding Selected.ChannelName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Selected.TimeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" MaxHeight="66" TextTrimming="WordEllipsis"
                                   FontSize="14" />
                        <TextBlock Text="{Binding RecordMessage}" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding RecordMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
