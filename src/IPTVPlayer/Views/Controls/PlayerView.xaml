<UserControl x:Class="IPTVPlayer.Views.Controls.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IPTVPlayer.ViewModels"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Background="Black">

    <!--
        O VideoView é uma janela nativa (HWND). Tudo o que estiver por cima do vídeo tem de ser
        conteúdo do VideoView: o LibVLCSharp mostra-o numa janela transparente sobreposta.
        O fundo #01000000 (quase transparente) é necessário para essa janela receber o rato.
    -->
    <vlc:VideoView x:Name="Video" Background="Black">
        <Grid x:Name="Overlay" Background="#01000000" Focusable="True" FocusVisualStyle="{x:Null}"
              TextElement.Foreground="White" TextElement.FontFamily="{StaticResource UiFont}"
              MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseLeftButtonUp">

            <!-- Canal atual (aparece alguns segundos ao mudar de canal) -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24" Padding="18,12" CornerRadius="10"
                    Background="{StaticResource OverlayBrush}"
                    Visibility="{Binding Player.IsOsdVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Player.CurrentItem.NumberText}" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Player.CurrentItem.Name}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Player.CurrentItem.Subtitle}" FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- "A retomar em 12:34 · Começar do início" -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="16,8" CornerRadius="10"
                    Background="{StaticResource OverlayBrush}"
                    Visibility="{Binding Player.IsResumeNoticeVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="16" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Player.ResumeText}" FontSize="16" VerticalAlignment="Center" />
                    <Button Content="Começar do início" Margin="14,0,0,0" Padding="12,4" FontSize="14"
                            Command="{Binding Player.StartOverCommand}" />
                </StackPanel>
            </Border>

            <!-- Sem canal -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding Player.IsIdle, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="56" Foreground="#55FFFFFF" />
                <TextBlock Text="Escolhe um canal para começar" FontSize="20" Foreground="#99FFFFFF" Margin="0,14,0,0" />
            </StackPanel>

            <!-- A abrir / buffering -->
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,20" CornerRadius="10"
                    Background="{StaticResource OverlayBrush}" IsHitTestVisible="False"
                    Visibility="{Binding Player.IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="220" />
                    <TextBlock Text="{Binding Player.StatusMessage}" FontSize="17" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Erro -->
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,24" CornerRadius="10" MaxWidth="560"
                    Background="{StaticResource OverlayBrush}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                    Visibility="{Binding Player.HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="40" Foreground="{StaticResource ErrorBrush}" />
                    <TextBlock Text="{Binding Player.StatusMessage}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,14,0,18" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Tentar novamente" HorizontalAlignment="Center"
                            Command="{Binding Player.RetryCommand}" />
                </StackPanel>
            </Border>

            <!-- Fim (filme/episódio) -->
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,24" CornerRadius="10"
                    Background="{StaticResource OverlayBrush}"
                    Visibility="{Binding Player.HasEnded, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="40" Foreground="{StaticResource AccentHoverBrush}" />
                    <TextBlock Text="Terminou" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,18" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Ver de novo" HorizontalAlignment="Center"
                            Command="{Binding Player.RetryCommand}" />
                </StackPanel>
            </Border>

            <!-- A gravar -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,0,0,0" Padding="10,4" CornerRadius="0,0,6,6"
                    Background="#E6D32F2F" IsHitTestVisible="False"
                    Visibility="{Binding IsRecordingCurrent, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="● REC" FontSize="14" FontWeight="Bold" />
            </Border>

            <!-- Aviso curto (faixas, gravação…) -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="24" Padding="14,8" CornerRadius="8"
                    Background="{StaticResource OverlayBrush}" IsHitTestVisible="False"
                    Visibility="{Binding Player.ToastText, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Player.ToastText}" FontSize="16" />
            </Border>

            <!-- Painel de áudio e legendas -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,100" Width="320" MaxHeight="380"
                    Padding="16,12" CornerRadius="10" Background="#F2161920" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding Player.IsTracksPanelOpen, Converter={StaticResource BoolToVisibility}}">
                <Border.Resources>
                    <DataTemplate x:Key="TrackTemplate" DataType="{x:Type vm:TrackItem}">
                        <DockPanel>
                            <TextBlock x:Name="Tick" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" Width="22"
                                       Foreground="{StaticResource AccentHoverBrush}" Visibility="Hidden" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="15" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                    <Style x:Key="TrackButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ÁUDIO (A)" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="Sem faixas de áudio." Style="{StaticResource SecondaryText}"
                                   Visibility="{Binding Player.AudioTracks.Count, Converter={StaticResource ZeroToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Player.AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackItem}">
                                    <Button Style="{StaticResource TrackButton}" ContentTemplate="{StaticResource TrackTemplate}" Content="{Binding}"
                                            Command="{Binding DataContext.Player.SelectAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="LEGENDAS (S)" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                        <ItemsControl ItemsSource="{Binding Player.SubtitleTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackItem}">
                                    <Button Style="{StaticResource TrackButton}" ContentTemplate="{StaticResource TrackTemplate}" Content="{Binding}"
                                            Command="{Binding DataContext.Player.SelectSubtitleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Abrir ficheiro de legendas…" Margin="0,10,0,0" FontSize="14" Padding="10,6"
                                HorizontalAlignment="Left" Click="OpenSubtitles_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Barra de controlos -->
            <Border x:Name="ControlBar" VerticalAlignment="Bottom" Padding="16,36,16,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <!-- Barra de tempo (só filmes/episódios) -->
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6"
                               Visibility="{Binding Player.IsSeekable, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Player.TimeText}" FontSize="15" Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="SeekBar" Minimum="0" Maximum="{Binding Player.LengthMs}" Value="{Binding Player.PositionMs, Mode=TwoWay}"
                                VerticalAlignment="Center" ToolTip="Avançar / recuar (← / →)"
                                PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource PlayerButton}" Content="&#xE892;" ToolTip="Anterior (↑ / PgUp)"
                                Command="{Binding PreviousChannelCommand}" />
                        <Button Style="{StaticResource PlayerButton}" ToolTip="Reproduzir / pausa (Espaço)"
                                Command="{Binding Player.TogglePauseCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Content="&#xE893;" ToolTip="Seguinte (↓ / PgDn)"
                                Command="{Binding NextChannelCommand}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Padding="12,6" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Background="#33FFFFFF"
                                ToolTip="Ver o programa atual desde o início (R)" Command="{Binding RestartProgrammeCommand}"
                                Visibility="{Binding CanRestartProgramme, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,6,0" />
                                <TextBlock Text="Desde o início" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Background="{StaticResource AccentBrush}"
                                ToolTip="Voltar à emissão em direto" Command="{Binding BackToLiveCommand}"
                                Visibility="{Binding IsCatchupPlaying, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,6,0" />
                                <TextBlock Text="Direto" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" ToolTip="Gravar este canal (até ao fim do programa)"
                                AutomationProperties.Name="Gravar" Command="{Binding ToggleRecordCommand}"
                                Visibility="{Binding Player.CurrentChannel, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE7C8;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecordingCurrent}" Value="True">
                                                <Setter Property="Text" Value="&#xE71A;" />
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Content="&#xE7F0;" ToolTip="Áudio e legendas (A / S)"
                                AutomationProperties.Name="Áudio e legendas" Command="{Binding Player.ToggleTracksPanelCommand}" />
                        <Button Style="{StaticResource PlayerButton}" ToolTip="Sem som (M)" Command="{Binding Player.ToggleMuteCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE767;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Player.IsMuted}" Value="True">
                                                <Setter Property="Text" Value="&#xE74F;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Slider Width="130" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="4,0,12,0"
                                Value="{Binding Player.Volume}" ToolTip="Volume (+ / −)" />
                        <Button Style="{StaticResource PlayerButton}" ToolTip="Favorito"
                                Visibility="{Binding Player.IsVod, Converter={StaticResource InverseBoolToVisibility}}"
                                Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding Player.CurrentChannel}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE734;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Player.CurrentChannel.IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="{StaticResource FavoriteBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" ToolTip="Ecrã inteiro (F / duplo clique)"
                                Command="{Binding ToggleFullscreenCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE740;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                <Setter Property="Text" Value="&#xE73F;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding Player.CurrentItem.Name}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </vlc:VideoView>
</UserControl>
