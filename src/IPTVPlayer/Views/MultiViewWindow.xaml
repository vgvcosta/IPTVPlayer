<Window x:Class="IPTVPlayer.Views.MultiViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IPTVPlayer.Views.Controls"
        Title="Multi-ecrã" Width="1400" Height="860" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="Black" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TopBar" Background="{StaticResource SurfaceBrush}" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Ecrã inteiro (F)"
                        Click="Fullscreen_Click" />
                <TextBlock Text="Multi-ecrã" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="Clica num quadro (ou 1–4) para ouvir esse canal · F: ecrã inteiro · Esc: sair · Cada quadro é uma ligação ao fornecedor." />
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="1" Rows="2" Columns="2">
            <controls:MultiViewTile DataContext="{Binding Tiles[0]}" />
            <controls:MultiViewTile DataContext="{Binding Tiles[1]}" />
            <controls:MultiViewTile DataContext="{Binding Tiles[2]}" />
            <controls:MultiViewTile DataContext="{Binding Tiles[3]}" />
        </UniformGrid>
    </Grid>
</Window>
