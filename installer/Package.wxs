<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    UpgradeCode NUNCA muda: é o que permite que uma versão nova substitua a anterior.
    Os dados do utilizador (%AppData%\IPTVPlayer) não são tocados ao instalar, atualizar ou desinstalar.
  -->
  <Package Name="PepinoTv"
           Manufacturer="Vitor Costa"
           Version="$(Version)"
           UpgradeCode="5E0C4E7B-6A2F-4C1D-9B8E-2D7A4F3C1B90"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="PepinoTv $(Version) — leitor de IPTV para Windows" />

    <MajorUpgrade DowngradeErrorMessage="Já está instalada uma versão mais recente do [ProductName]." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\src\IPTVPlayer\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/vgvcosta/IPTVPlayer" />
    <Property Id="ARPHELPLINK" Value="https://github.com/vgvcosta/IPTVPlayer/issues" />

    <!-- Ecrãs: boas-vindas, licença, pasta de instalação, progresso -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PepinoTv" />
    </StandardDirectory>

    <Feature Id="Main" Title="PepinoTv" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Todos os ficheiros da versão publicada (app, .NET e VLC) -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <!-- Atalhos: o Windows Installer exige uma chave em HKCU como "KeyPath" (regras ICE38/43/57). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7C1A1E52-3B4E-4F0B-8C2D-6E5F9A1B2C30">
        <Shortcut Id="StartMenuShortcutLink" Name="PepinoTv" Description="Leitor de IPTV"
                  Target="[INSTALLFOLDER]IPTVPlayer.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\IPTVPlayer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="0D9B6A3E-58C1-4E27-A4F9-3B2C1D0E9F84">
        <Shortcut Id="DesktopShortcutLink" Name="PepinoTv" Description="Leitor de IPTV"
                  Target="[INSTALLFOLDER]IPTVPlayer.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\IPTVPlayer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Package>
</Wix>
