<UserControl x:Class="IPTVPlayer.Views.Controls.MultiViewTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IPTVPlayer.ViewModels"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MultiViewTileViewModel}">
    <!-- Moldura fora do vídeo (a janela nativa do VLC tapa tudo o que estiver por cima dela) -->
    <Border x:Name="Frame" BorderThickness="3" Background="Black">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <vlc:VideoView x:Name="Video" Background="Black">
            <Grid x:Name="Overlay" Background="#01000000" TextElement.Foreground="White"
                  TextElement.FontFamily="{StaticResource UiFont}" MouseLeftButtonUp="Overlay_MouseLeftButtonUp">
                <!-- Nome do canal e som -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Padding="10,5" CornerRadius="6"
                        Background="{StaticResource OverlayBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NumberText}" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Channel.Name}" FontSize="15" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Margin="10,0,0,0" ToolTip="Este quadro tem o som"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Margin="8"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AB;" ToolTip="Trocar de canal" Background="#99000000"
                            Command="{Binding ChooseCommand}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Fechar este quadro" Background="#99000000"
                            Command="{Binding ClearCommand}" />
                </StackPanel>

                <!-- Quadro vazio -->
                <Button HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,10" Command="{Binding ChooseCommand}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock>
                            <Run Text="Escolher canal" /><Run Text=" (" /><Run Text="{Binding NumberText, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="20" IsHitTestVisible="False"
                           Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}" />
            </Grid>
        </vlc:VideoView>
    </Border>
</UserControl>
