<Window x:Class="IPTVPlayer.Views.AddPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IPTVPlayer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AddPlaylistViewModel}"
        Title="{Binding Title}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />

        <!-- Tipo -->
        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="4" Margin="0,16,0,4"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
            <UniformGrid Columns="3" IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolean}}">
                <RadioButton Style="{StaticResource SegmentRadio}" Content="URL M3U" GroupName="Kind" IsChecked="{Binding IsM3uUrl}" />
                <RadioButton Style="{StaticResource SegmentRadio}" Content="Ficheiro local" GroupName="Kind" IsChecked="{Binding IsM3uFile}" />
                <RadioButton Style="{StaticResource SegmentRadio}" Content="Xtream Codes" GroupName="Kind" IsChecked="{Binding IsXtream}" />
            </UniformGrid>
        </Border>

        <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
            <TextBlock Text="Nome (opcional)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" AutomationProperties.Name="Nome" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: Canais de casa" />

            <!-- URL M3U -->
            <StackPanel Visibility="{Binding IsM3uUrl, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="URL da playlist (M3U / M3U8)" Style="{StaticResource FieldLabel}" />
                <TextBox AutomationProperties.Name="URL da playlist" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Tag="http://exemplo.com/lista.m3u" />
            </StackPanel>

            <!-- Ficheiro -->
            <StackPanel Visibility="{Binding IsM3uFile, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Ficheiro" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Procurar…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                    <TextBox AutomationProperties.Name="Ficheiro" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Tag="C:\…\lista.m3u" />
                </DockPanel>
            </StackPanel>

            <!-- Xtream -->
            <StackPanel Visibility="{Binding IsXtream, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Servidor" Style="{StaticResource FieldLabel}" />
                <TextBox AutomationProperties.Name="Servidor" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Tag="http://servidor.com:8080" />
                <TextBlock Text="Utilizador" Style="{StaticResource FieldLabel}" />
                <TextBox AutomationProperties.Name="Utilizador" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" PasswordChanged="PasswordInput_PasswordChanged" />
                <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="As credenciais ficam guardadas encriptadas (DPAPI) e só a tua conta do Windows as consegue ler."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>

            <!-- EPG -->
            <TextBlock Text="URL do EPG / XMLTV (opcional)" Style="{StaticResource FieldLabel}" />
            <TextBox AutomationProperties.Name="URL do EPG" Text="{Binding CustomEpgUrl, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Vazio = usa o da playlist (url-tvg) ou do servidor Xtream" />
            <TextBlock Text="Aceita http(s), ficheiros .xml ou .xml.gz e caminhos locais."
                       Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Progresso -->
        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding Progress}" Maximum="1" />
            <TextBlock Text="{Binding ProgressMessage}" Margin="0,8,0,0" FontSize="14" />
        </StackPanel>

        <!-- Erro -->
        <Border Margin="0,18,0,0" Padding="12,10" CornerRadius="6" Background="#26FF6B6B"
                BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" MinWidth="110" />
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}"
                    IsDefault="True" MinWidth="130" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
