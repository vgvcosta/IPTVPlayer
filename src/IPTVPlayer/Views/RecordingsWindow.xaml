<Window x:Class="IPTVPlayer.Views.RecordingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IPTVPlayer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:RecordingsViewModel}"
        Title="Gravações" Width="860" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15" UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" />
    </Window.CommandBindings>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Padding="12,6" FontSize="14" Command="{Binding OpenFolderCommand}" ToolTip="{Binding Folder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                    <TextBlock Text="Abrir pasta" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Gravações" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Grava com ● no player (canal em direto) ou agenda no Guia TV. As agendadas só gravam com a app aberta."
                           Style="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" AutomationProperties.Name="Gravações">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RecordingItemViewModel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Ver" Padding="12,4" FontSize="14" Margin="6,0,0,0"
                                    Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                    Visibility="{Binding CanPlay, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Parar" Padding="12,4" FontSize="14" Margin="6,0,0,0"
                                    Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                    Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" FontSize="15" Width="34" Height="34" ToolTip="Mostrar na pasta"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="15" Width="34" Height="34" ToolTip="Apagar"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        </StackPanel>
                        <Border x:Name="Status" DockPanel.Dock="Left" Width="104" CornerRadius="5" Padding="8,3" Margin="0,0,14,0"
                                VerticalAlignment="Center" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding StatusText}" FontSize="13" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ChannelName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Status" Property="Background" Value="#66FF4D4D" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                            <Setter TargetName="Status" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="Ainda não há gravações." Style="{StaticResource SecondaryText}" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibility}}" />

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
    </Grid>
</Window>
