<Window x:Class="IPTVPlayer.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controlo parental" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15" UseLayoutRounding="True">
    <StackPanel Margin="24,20,24,22">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="22" Foreground="{StaticResource AccentHoverBrush}" />
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,12,0,14" Foreground="{StaticResource TextSecondaryBrush}" />
        <PasswordBox x:Name="PinBox" AutomationProperties.Name="PIN" MaxLength="8" FontSize="22" HorizontalContentAlignment="Center"
                     PasswordChanged="PinBox_PasswordChanged" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,0" Visibility="Collapsed"
                   Text="PIN errado. Tenta outra vez." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" MinWidth="100" IsCancel="True" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Desbloquear" MinWidth="120" Margin="10,0,0,0"
                    IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
