<Window x:Class="IPTVPlayer.Views.ChannelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IPTVPlayer.ViewModels"
        Title="Escolher canal" Width="480" Height="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15" UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBox x:Name="SearchBox" Grid.Row="1" Tag="Pesquisar…" AutomationProperties.Name="Pesquisar"
                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
        <ListBox x:Name="List" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource PlainList}"
                 MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}" />
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChannelItemViewModel}">
                    <DockPanel Height="34">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="52" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GroupTitle}" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
